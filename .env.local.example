# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Invoice extraction — pick which model reads invoices.
#   anthropic → Claude Haiku 4.5  (PDF / image / HTML)
#   google    → Gemini 2.5 Flash  (PDF / image / HTML)
#   deepseek  → DeepSeek Chat      (HTML / text only, no file input)
EXTRACTION_PROVIDER=anthropic

# Anthropic (Claude)
ANTHROPIC_API_KEY=
# ANTHROPIC_EXTRACTION_MODEL=claude-haiku-4-5

# Google Gemini
GEMINI_API_KEY=
# Legacy alias — also accepted when EXTRACTION_PROVIDER=google.
GOOGLE_API_KEY=
# GOOGLE_EXTRACTION_MODEL=gemini-2.5-flash

# DeepSeek
DEEPSEEK_API_KEY=
# DEEPSEEK_EXTRACTION_MODEL=deepseek-chat

# Upstash Redis — rate limits uploads (10/min/user) and login / sign-up /
# password-reset attempts. Does NOT limit email intake. Optional: if unset,
# every limiter no-ops. Strongly recommended for any public deploy.
# https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Optional: email forwarding (set BOTH AgentMail keys or neither) ---
# Leave all empty to run without it (Automation page and forwarding address are
# hidden). Setting only some of them fails at startup.
# AgentMail: https://agentmail.to — one inbox per user.
# Trigger.dev (optional; without it the webhook processes emails inline, no retries):
# https://cloud.trigger.dev → Project settings / API Keys. Also put
# your project ref in `project` in trigger.config.ts.
AGENTMAIL_API_KEY=
AGENTMAIL_WEBHOOK_SECRET=
TRIGGER_SECRET_KEY=
